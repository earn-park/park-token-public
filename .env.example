BSC_RPC_URL=
BSC_PRIVATE_KEY=
BSC_DEFAULT_ADMIN_ADDRESS=
BSC_RESCUER_ADDRESS=
BSC_INITIAL_HOLDER=
# STAGING DEFAULT. Production deploys MUST set BSC_PRODUCTION_MODE=true
# (see below) which hard-rejects this value at resolveBscEnv().
BSC_TIMELOCK_DELAY_SECONDS=900
BSC_DEFAULT_ADMIN_TRANSFER_DELAY_SECONDS=172800
# Production hard gate (CertiK pre-audit H-02). When true, deploy-bsc.ts
# rejects BSC_TIMELOCK_DELAY_SECONDS < 21600 AND requires Safe threshold
# >= 3 with owner count >= 5 (no duplicates) before broadcasting any tx.
# Default: false (bootstrap rehearsal). Flip to true ONLY for the final
# production deploy that backs TGE / CEX listing / public distribution.
BSC_PRODUCTION_MODE=false
BSC_CONTRACT_URI=https://earnpark.com/token-metadata.json
# build-bsc-calldata.ts only (optional): deployed Timelock address for pre-deploy calldata
BSC_UPGRADER_ADDRESS=
# build-bsc-calldata.ts only (optional): deployer EOA address for CREATE3 address prediction
BSC_DEPLOYER_ADDRESS=
MULTI_EXPLORER_API_KEY=
TARGET_CHAIN=bsc
