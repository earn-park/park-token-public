BSC_RPC_URL=
BSC_PRIVATE_KEY=
BSC_DEFAULT_ADMIN_ADDRESS=
BSC_RESCUER_ADDRESS=
BSC_INITIAL_HOLDER=
# STAGING DEFAULT. Production deploys MUST set BSC_PRODUCTION_MODE=true
# (see below) which hard-rejects this value at resolveBscEnv().
BSC_TIMELOCK_DELAY_SECONDS=900
BSC_DEFAULT_ADMIN_TRANSFER_DELAY_SECONDS=172800
# Production hard gate (CertiK pre-audit H-02). When true, deploy-bsc.ts
# rejects BSC_TIMELOCK_DELAY_SECONDS < 21600 AND requires Safe threshold
# >= 3 with owner count >= 5 (no duplicates) before broadcasting any tx.
# Default: false (bootstrap rehearsal). Flip to true ONLY for the final
# production deploy that backs TGE / CEX listing / public distribution.
BSC_PRODUCTION_MODE=false
# Expected-address preflight (CertiK pre-audit M-03). When set, deploy-bsc.ts
# aborts on mismatch BEFORE broadcasting any tx. Defends against wrong-key,
# wrong-salt, and wrong-chain deploys. Both are REQUIRED when
# BSC_PRODUCTION_MODE=true; OPTIONAL (info-only) for bootstrap.
BSC_EXPECTED_DEPLOYER=
BSC_EXPECTED_PROXY_ADDRESS=
# Expected initial supply holder (audit CR-01). The full 1B PARK supply is
# minted to BSC_INITIAL_HOLDER at initialize(). When set, deploy-bsc.ts
# aborts on mismatch BEFORE broadcasting. REQUIRED under
# BSC_PRODUCTION_MODE=true (so a poisoned env can't allocate the cap to
# an unintended address); OPTIONAL info-log under bootstrap.
BSC_EXPECTED_INITIAL_HOLDER=
# Bytecode-baseline pre-broadcast gate attestation (audit M-02). When
# BSC_PRODUCTION_MODE=true, deploy-bsc.ts REQUIRES this to be "true" — the
# operator must have just run `bash scripts/repro.sh` cleanly in the same
# shell session and export this flag to confirm. Defends against deploying
# bytecode that differs from the published audit baseline.
BSC_REPRO_VERIFIED=false
BSC_CONTRACT_URI=https://earnpark.com/token-metadata.json
# build-bsc-calldata.ts only (optional): deployed Timelock address for pre-deploy calldata
BSC_UPGRADER_ADDRESS=
# build-bsc-calldata.ts only (optional): deployer EOA address for CREATE3 address prediction
BSC_DEPLOYER_ADDRESS=
MULTI_EXPLORER_API_KEY=
TARGET_CHAIN=bsc
