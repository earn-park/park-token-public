# HARD RULE: every dependency version must be EXACT (no ^, no ~, no *)
# Rationale: supply-chain safety for a mainnet-deployed token project.
# Any version range allows an upstream publish to silently alter the
# installed bytecode-generating toolchain (tsx/typescript/hardhat/viem)
# or the ABI-encoding library, which invalidates reproducibility.
#
# This file enforces the rule at the npm client level:
#   save-exact       — `npm i <pkg>` writes `"pkg": "1.2.3"`, not `"^1.2.3"`
#   ignore-scripts   — block postinstall scripts (common malware vector)
#   audit-level      — fail install on any moderate+ vulnerability
#   fund=false       — suppress funding banner noise
#
# When bumping a dep, edit package.json manually (or via `npm i pkg@1.2.4`)
# and commit both package.json + package-lock.json. Never remove --save-exact.
save-exact=true
ignore-scripts=true
audit-level=moderate
fund=false
# 24-hour publish-cooldown defence (defends against compromised-publish
# windows, e.g. the 2018 eventstream / 2024 chalk attacks resolved within
# a day).
#
# IMPORTANT — tooling-conditional: this key is RECOGNISED only by pnpm
# (≥9), not by npm. npm v11 ignores it with the warning
# `Unknown project config "minimum-release-age"` (verified on npm 11.6.2,
# 2026-05-10). npm v11 also does not recognise the alternative name
# `min-release-age`. The cooldown is therefore enforced only when
# operators install via pnpm; npm-based installs (CI + most workstations)
# are NOT cooldown-gated by this line.
#
# Path forward: either (a) adopt pnpm via `packageManager` in package.json
# and have CI use it, OR (b) wait for npm to ship a cooldown setting and
# add the matching key. Until then, treat the cooldown as advisory only.
# Setting kept for forward-compat with future npm versions and active
# pnpm users.
minimum-release-age=1440
# Refuse install when local Node version is outside the package.json `engines`
# range. Keeps the documented Node 22.x toolchain matched in CI + on operator
# workstations.
engine-strict=true
